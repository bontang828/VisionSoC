<mxCell id="title" parent="1" vertex="1" value="Mapping a 2-D image onto the 2-D vector fabric" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#212121;"><mxGeometry x="20" y="18" width="900" height="26" as="geometry"/></mxCell>
<mxCell id="note" parent="1" vertex="1" value="A 1-D vector register holds one image row (pixel &#8594; lane). Stack 16 of them and the fabric holds the whole image &#8212; rows of the picture line up with hardware rows." style="text;html=1;align=left;fontSize=11;fontColor=#5D6D7E;whiteSpace=wrap;"><mxGeometry x="20" y="44" width="1000" height="18" as="geometry"/></mxCell>
