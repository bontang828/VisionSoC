  <diagram name="VisionSoC Level 1 v2" id="visionsoc-level1-v2">
    <mxGraphModel dx="1820" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0">
      <root>
