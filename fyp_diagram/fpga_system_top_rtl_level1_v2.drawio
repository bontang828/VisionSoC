          <mxGeometry x="40" y="20" width="1200" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" parent="1" vertex="1"
          value="Block names describe what each unit does; bracketed tags reference the synthesis-report cell name. Data path flows left to right; configuration/control comes down from the top."
