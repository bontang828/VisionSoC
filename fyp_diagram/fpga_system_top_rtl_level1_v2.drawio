            </Array>
          </mxGeometry>
        </mxCell>

        <!-- PS EMIO -> AP1302 reset (long route around bottom of page) -->
        <mxCell id="e_s2" parent="1" edge="1" source="b_ps_emio" target="b_ap1302"
