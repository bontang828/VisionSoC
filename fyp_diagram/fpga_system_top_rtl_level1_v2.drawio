        <mxCell id="b_dma" parent="1" vertex="1"
          value="Memory Mover&#10;(DMA Engine)&#10;&#10;Transfers blocks of data&#10;between DDR and the&#10;shared scratchpad while&#10;the CPU does other work&#10;[axi_dma]"
