        <!-- =============================================================
             PL COMPUTE SUBSYSTEM BLOCKS
             ============================================================= -->

        <mxCell id="b_t1" parent="1" vertex="1"
          value="T1 Vector Compute Core&#10;&#10;Custom RISC-V vector unit&#10;runs vision kernels:&#10;Sobel, blur, optical flow,&#10;histogram, &#8230;&#10;&#10;Reads/writes the shared&#10;on-chip scratchpad as it&#10;computes&#10;[t1_fpga_top]"
