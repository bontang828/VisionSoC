        </mxCell>

        <mxCell id="b_data_ic" parent="1" vertex="1"
          value="Compute Data Crossbar&#10;&#10;Arbitrates between three&#10;requesters &#8212; the vector&#10;core (reads + writes),&#10;DMA outbound (reads&#10;DDR), and DMA inbound&#10;(writes DDR) &#8212; sharing&#10;the scratchpad and the&#10;PS memory port&#10;[smartconnect_hb + _idx]"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#827717;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;fontColor=#212121;fontStyle=1;">
