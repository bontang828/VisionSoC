        </mxCell>

        <mxCell id="b_dma_skid" parent="1" vertex="1"
          value="DMA Streaming Loopback&#10;&#10;Wraps the DMA&#39;s output stream&#10;back into its input stream&#10;(enables memory-to-memory&#10;copy)&#10;[axis_reg_slice_dma]"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#212121;">
