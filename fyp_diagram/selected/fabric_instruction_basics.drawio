                <mxCell id="title" value="Instruction basics on the 2-D fabric — the SAME opcode, Horizontal vs Vertical mode" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#212121;" parent="1" vertex="1">
                    <mxGeometry x="14" y="14" width="820" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="One instruction per row. Colour tracks where data goes (numbers where the value matters). Flipping CSR 0x7c0 rotates each spatial op 90° — so a pixel is free to move anywhere on the grid. (vadd / vmv / vmerge are element-wise, so H = V.)" style="text;html=1;align=left;fontSize=11;fontColor=#5D6D7E;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="14" y="40" width="799" height="28" as="geometry"/>
