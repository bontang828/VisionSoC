                <mxCell id="title" value="Programmability:  T1 2D fabric  vs  SCAMP-5 pixel-processor array" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#212121;" parent="1" vertex="1">
                    <mxGeometry x="15" y="-1" width="853" height="21" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="SCAMP-5 has one analog processor per pixel but its ONLY links are the 4 nearest neighbours (N/E/W/S), run in with SIMD. Data transfer must moves must walk cell-by-cell; Non-uniform ops (each pixel a different distance from the target) need many shift rounds. T1 reaches any lane directly (gather / slide / H-V transpose) and reduction in hardware." style="text;html=1;align=left;fontSize=16;fontColor=#5D6D7E;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="17.5" y="28" width="885.5" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="l1" value="SCAMP-5 PE  —  4 neighbours only" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#B85450;" parent="1" vertex="1">
