                <mxCell id="title" value="Stock 1D RVV  vs  T1 2D RVV:  data residency &amp;amp; H/V mode flip" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#212121;" parent="1" vertex="1">
                    <mxGeometry x="9" y="8" width="941" height="21" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="On a 1D vector machine each image row must be fetched into a register and stored back; switching orientation forces strided&amp;nbsp;&lt;div&gt;memory access.&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;T1 keeps the whole plane in the VRF and toggles horizontal↔vertical with one Configuration and Status&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Register(CSR) bit.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#5D6D7E;" parent="1" vertex="1">
                    <mxGeometry x="9" y="37" width="919" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="taskA" value="Task A · Process all N rows of an image (e.g. load/store a grid of matrix / pixels)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#37474F;" parent="1" vertex="1">
                    <mxGeometry x="11.09" y="100" width="987.91" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="l42" value="T1 2D fabric" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#2E7D32;" parent="1" vertex="1">
                    <mxGeometry x="20.59" y="156.00000000000006" width="90" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="r85" value="✓ memory transactions  (load / store) N rows processed in parallel by one instruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1;fontSize=16;fontColor=#2E7D32;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="187" y="140" width="659" height="28" as="geometry"/>
                </mxCell>
