                </mxCell>
                <mxCell id="r131" value="✗ N memory transactions (load / store per row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=16;fontColor=#B85450;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="307" y="531" width="458" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="l132" value="Sequential iteration to load / store each row" style="text;html=1;align=left;fontSize=16;fontStyle=3;fontColor=#4D4D4D;" parent="1" vertex="1">
                    <mxGeometry x="374" y="492" width="580" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="taskB" value="Task B · Alternating Horizontal &amp;amp; Vertical operations  (with serial data dependency)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#37474F;" parent="1" vertex="1">
                    <mxGeometry x="13.559999999999999" y="594" width="900.06" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="l205" value="data stays in the SAME VRF registers; only the mode bit changes, which change access direction" style="text;html=1;align=center;fontSize=16;fontStyle=3;fontColor=#2E7D32;" parent="1" vertex="1">
                    <mxGeometry x="229.12" y="806" width="592" height="14" as="geometry"/>
                </mxCell>
