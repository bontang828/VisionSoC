                <mxCell id="r249" value="each step pays the full memory round-trip; transpose-buffer cannot be reused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F4;strokeColor=#D0D7DE;strokeWidth=1;fontSize=10;fontColor=#B85450;align=center;verticalAlign=middle;" parent="1" vertex="1">
