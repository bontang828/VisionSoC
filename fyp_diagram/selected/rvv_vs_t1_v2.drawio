                <mxCell id="r241" value="whole image plane lives in VRF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FBF4;strokeColor=#D0D7DE;strokeWidth=1;fontSize=10;fontColor=#2E7D32;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="580" y="834" width="480" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="r242" value="Memory traffic (N×N image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D0D7DE;strokeWidth=1;fontSize=10;fontColor=#212121;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="20" y="870" width="200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="r243" value="2N transactions (load + store per row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F4;strokeColor=#D0D7DE;strokeWidth=1;fontSize=10;fontColor=#B85450;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="220" y="870" width="360" height="36" as="geometry"/>
                </mxCell>
