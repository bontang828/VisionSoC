                <mxCell id="title" value="Sobel kernel — Sobel edge filter on the T1 fabric  (3×3 worked example)" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#212121;" parent="1" vertex="1">
                    <mxGeometry x="24" y="19" width="820" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="Steps run top → bottom. Each image pixel has its own colour, so you can track its position: Step 2 moves data sideways (within a row), Step 4 moves the SAME data up/down (between rows) using the identical vslidedown / vslideup — only the mode bit changed. Gx/Gy are sign-coloured (warm +, cool −)." style="text;html=1;align=left;fontSize=16;fontColor=#5D6D7E;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="24.09" y="51" width="900" height="28" as="geometry"/>
