    <diagram name="t1_vs_scamp5" id="t1-vs-scamp5">
        <mxGraphModel dx="933" dy="482" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="860" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Programmability:  T1 2-D fabric  vs  SCAMP-5 pixel-processor array" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#212121;" parent="1" vertex="1">
                    <mxGeometry width="1240" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="SCAMP-5 has one analog processor per pixel but its ONLY links are the 4 nearest neighbours (N/E/W/S), run in lock-step (SIMD). Non-local moves must walk cell-by-cell; asymmetric ops (each pixel a different distance from the target) need many uniform-shift rounds. T1 reaches any lane directly (gather / slide / H-V transpose) and reduces in hardware." style="text;html=1;align=left;fontSize=10;fontColor=#5D6D7E;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry y="26" width="1240" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="l1" value="SCAMP-5 PE  —  4 neighbours only" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#B85450;" parent="1" vertex="1">
