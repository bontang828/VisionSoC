<mxCell id="title" parent="1" vertex="1" value="Stock 1-D RVV  vs  T1 2-D RVV:  data residency &amp; H/V mode flip" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#212121;"><mxGeometry x="15" y="-1" width="1070" height="21" as="geometry"/></mxCell>
<mxCell id="subtitle" parent="1" vertex="1" value="On a 1-D vector machine each image row must be fetched into a register and stored back; switching orientation forces strided memory access. T1 keeps the whole plane in the VRF and toggles horizontal&#8596;vertical with one CSR bit." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5D6D7E;"><mxGeometry x="17" y="28" width="1070" height="32" as="geometry"/></mxCell>
