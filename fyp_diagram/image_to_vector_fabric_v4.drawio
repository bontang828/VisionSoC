<mxCell id="title" parent="1" vertex="1" value="How an image maps onto vector hardware:  1-D machine  vs  our 2-D processor" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#212121;"><mxGeometry x="40" y="18" width="1320" height="30" as="geometry"/></mxCell>
<mxCell id="sub" parent="1" vertex="1" value="A 1-D machine streams the image one row at a time; our 2-D processor holds the whole plane and processes along rows OR columns." style="text;html=1;align=left;fontSize=13;fontColor=#5D6D7E;"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell>
