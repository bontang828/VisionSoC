        <mxCell id="tr_vc" parent="1" vertex="1" value="vec: current row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9B5;strokeColor=#D6B656;fontSize=11;"><mxGeometry x="300" y="844" width="190" height="34" as="geometry"/></mxCell>
        <mxCell id="tr_vb" parent="1" vertex="1" value="vec: row below (B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBC6DC;strokeColor=#9673A6;fontSize=11;"><mxGeometry x="300" y="900" width="190" height="34" as="geometry"/></mxCell>
