        <mxCell id="tr_mr2" parent="1" vertex="1" value="row r+1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBC6DC;strokeColor=#FFFFFF;strokeWidth=2;fontSize=10;"><mxGeometry x="72" y="900" width="86" height="34" as="geometry"/></mxCell>

